# Environment reference only; no automatic dotenv loading. Never put real tokens here.
CANVAS_BASE_URL=https://canvas.example.invalid
# Local operator only: comma-separated exact RFC1918/ULA IP literals for the
# configured Canvas hostname. Public DNS answers require no static IP pin.
CANVAS_TRUSTED_PRIVATE_IPS=
# Deprecated: true requires CANVAS_TRUSTED_PRIVATE_IPS and grants nothing broader.
CANVAS_ALLOW_PRIVATE_ORIGIN=false
CANVAS_ACCESS_TOKEN=
# Required only for downloads. Dedicated local-drive root OUTSIDE the project.
# Existing parent required; managed leaf is created with private Windows ACLs.
# Leave blank for metadata-only reads. Do not point at an existing general folder.
DOWNLOAD_DIRECTORY=
MAX_DOWNLOAD_BYTES=26214400
DOWNLOAD_TIMEOUT=120
MAX_DOWNLOAD_REDIRECTS=3
# Seconds; includes connection, headers, and streamed response reads.
REQUEST_TIMEOUT=20
# Zero disables caching; nonzero is unsupported until a cache is implemented.
CACHE_TTL=0
LOG_LEVEL=INFO
# Exact operator-approved HTTPS:443 CDN origins, comma-separated, no wildcards.
# Empty rejects off-origin downloads. No Authorization is sent on redirect hops.
CANVAS_DOWNLOAD_ORIGINS=

# Local diagnostic CLI only; optional separate private runtime leaf outside source.
CANVAS_MIME_RUNTIME_DIRECTORY=C:\canvas_mcp_runtime\diagnostics
CANVAS_APPLICATION_PROFILE=personal

# Phase 6.1 HTTP scaffold: no OAuth and no public deployment.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
# deny (default) or development. No unauthenticated/production bypass mode.
MCP_HTTP_AUTH_MODE=deny
MCP_HTTP_DEPLOYMENT=local
# Both development=true AND auth_mode=development are required to use dev auth.
MCP_HTTP_DEVELOPMENT=false
# Separate random bearer token, 32-256 URL-safe characters; never a Canvas token.
MCP_HTTP_DEV_TOKEN=
MCP_HTTP_MAX_BODY_BYTES=65536
MCP_HTTP_MAX_HEADER_BYTES=16384
MCP_HTTP_REQUEST_TIMEOUT=65
MCP_HTTP_MAX_CONCURRENCY=8
# HTTP development uses CANVAS_CREDENTIAL_PROVIDER=environment only.
# Leave DOWNLOAD_DIRECTORY empty; HTTP never constructs local download storage.
# Phase 6.2 remote reference only; never put real secrets in this file.
# MCP_HTTP_AUTH_MODE=oauth
# MCP_HTTP_DEPLOYMENT=production
# MCP_HTTP_HOST=0.0.0.0
# PORT is injected by the hosting provider; local default remains 8000.
# MCP_PUBLIC_BASE_URL=https://<service>.onrender.com
# AUTH0_DOMAIN=<tenant>.<region>.auth0.com
# AUTH0_ISSUER=https://<tenant>.<region>.auth0.com/
# AUTH0_AUDIENCE=https://<service>.onrender.com/mcp
# AUTH0_REQUIRED_SCOPES=canvas:read
# AUTH0_ALLOWED_SUBJECT=<runtime-private-subject>
