# Environment reference only; no automatic dotenv loading. Never put real tokens here.
CANVAS_BASE_URL=https://canvas.example.invalid
# Local operator only: comma-separated exact RFC1918/ULA IP literals for the
# configured Canvas hostname. Public DNS answers require no static IP pin.
CANVAS_TRUSTED_PRIVATE_IPS=
# Deprecated: true requires CANVAS_TRUSTED_PRIVATE_IPS and grants nothing broader.
CANVAS_ALLOW_PRIVATE_ORIGIN=false
CANVAS_ACCESS_TOKEN=
# Required only for downloads. Dedicated local-drive root OUTSIDE the project.
# Existing parent required; managed leaf is created with private Windows ACLs.
# Leave blank for metadata-only reads. Do not point at an existing general folder.
DOWNLOAD_DIRECTORY=
MAX_DOWNLOAD_BYTES=26214400
DOWNLOAD_TIMEOUT=120
MAX_DOWNLOAD_REDIRECTS=3
# Seconds; includes connection, headers, and streamed response reads.
REQUEST_TIMEOUT=20
# Zero disables caching; nonzero is unsupported until a cache is implemented.
CACHE_TTL=0
LOG_LEVEL=INFO
# Exact operator-approved HTTPS:443 CDN origins, comma-separated, no wildcards.
# Empty rejects off-origin downloads. No Authorization is sent on redirect hops.
CANVAS_DOWNLOAD_ORIGINS=

# Local diagnostic CLI only; optional separate private runtime leaf outside source.
CANVAS_MIME_RUNTIME_DIRECTORY=C:\canvas_mcp_runtime\diagnostics
CANVAS_APPLICATION_PROFILE=personal
