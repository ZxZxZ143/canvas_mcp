# Allowlist build context: runtime source and pinned packaging only.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!requirements-remote.lock
!requirements-remote-check.lock
!src/
!src/**

# Exclude even if produced underneath src/.
**/.git
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/.env*
**/downloads
**/diagnostics
**/tests
**/build
**/dist
**/runtime
**/artifacts
**/*.log

# Explicit synthetic build checks only. No other tests/fixtures or local data.
!tests/
tests/**
!tests/conftest.py
!tests/file_content_fixtures.py
!tests/unit/
!tests/unit/test_document_content.py
!tests/security/
!tests/security/test_ephemeral_storage.py
!tests/integration/
!tests/integration/test_remote_file_content.py
!tests/integration/test_remote_ocr.py
!tests/unit/test_ocr_selection.py

# Common exclusions take precedence over directory exceptions.
**/__pycache__
**/*.pyc
**/*.pyo
**/.env*
